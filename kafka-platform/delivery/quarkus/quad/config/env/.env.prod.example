# ── Production Environment ──────────────────────────────────
# Aktivierung: export $(cat deploy/.env.prod | xargs)
# oder: ./stack.sh up all --profile prod
#
# SICHERHEIT: Jupyter Notebook enthält keine Secrets.
# Verwende Secrets aus Secret Manager oder CI/CD Pipeline.

# ---- Quarkus ----
QUARKUS_PROFILE=prod
QUARKUS_HTTP_PORT=8086

# ---- PostgreSQL ----
POSTGRES_DB=quad
POSTGRES_USER=${PROD_DB_USER}
POSTGRES_PASSWORD=${PROD_DB_PASSWORD}
QUARKUS_DATASOURCE_DB_KIND=postgresql
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres-pgvector:5432/quad
QUARKUS_DATASOURCE_USERNAME=${PROD_DB_USER}
QUARKUS_DATASOURCE_PASSWORD=${PROD_DB_PASSWORD}

# ---- OpenAI / LLM ----
OPENAI_API_KEY=${PROD_OPENAI_API_KEY}
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ---- MCP ----
QUAD_MCP_CONFIG_PATH=/workspace/mcp-config.json

# ---- Keycloak / OIDC (Layer 3) ----
KEYCLOAK_ADMIN_PASSWORD=${PROD_KEYCLOAK_ADMIN_PASSWORD}
OIDC_ENABLED=true
OIDC_CLIENT_SECRET=${PROD_OIDC_CLIENT_SECRET}

# ---- OTel (aktiviert für Langfuse/Tempo) ----
# OTLP HTTP → OTel Collector (Port 4318; 4317 ist gRPC)
QUARKUS_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318
# Header werden nur relevant, wenn direkt an Langfuse exportiert wird
# (der OTel Collector reicht an Tempo weiter, verarbeitet keine Auth-Header).
QUARKUS_OTEL_EXPORTER_OTLP_TRACES_HEADERS="${LANGFUSE_OTEL_AUTH:-}"

# ---- Kafka ----
QUAD_MESSAGING_KAFKA_INBOUND_BOOTSTRAP_SERVERS=kafka:9092

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
