# Kopieren nach: set_env.local.sh
#
#   cp set_env.local.sh.example set_env.local.sh
#
# Diese Datei liegt in .gitignore und wird nicht eingecheckt. Hier gehoert der
# echte Schluessel hin — nicht in set_env.sh, sonst landet er beim Zufuegen.

